# 运行环境：dev / staging / prod
APP_ENV=dev
INSTANCE_NAME=guanlanai-dev

# Telegram Bot Token（Phase 0 可留空；Phase 1 起必填）
TELEGRAM_BOT_TOKEN=

# 32 字节随机值的 base64，用 `openssl rand -base64 32` 生成
# staging/prod 必填；开发环境可留空
APP_MASTER_KEY=

# 本地默认路径；Docker 内会被 compose 覆盖为 /data/guanlanai.db
DATABASE_PATH=./data/guanlanai.db
HTTP_ADDR=:8080
LOG_LEVEL=info

# 默认分析模式：short（短线）/ swing（波段）
DEFAULT_MODE=swing
DEFAULT_MODEL=
MODEL_ALLOWLIST=
# 严格模式：模型必须出现在 endpoint 的 /models 列表中；不支持 /models 的代理设为 false
STRICT_MODEL_LIST=true

# OpenAI 官方地址；用户可以再配置兼容代理
OPENAI_BASE_URL=https://api.openai.com/v1
# 仅本地开发回退；生产默认不启用
OPENAI_API_KEY=
ALLOW_SERVER_KEY=false

# 当前 VPS 所在区域 api.binance.com 返回 451，默认走 vision
BINANCE_BASE_URL=https://data-api.binance.vision
BINANCE_FALLBACK_BASE_URL=https://api.binance.com
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# 用户自定义 OpenAI 兼容 base_url
ALLOW_CUSTOM_BASE_URL=true
CUSTOM_BASE_URL_ALLOWLIST=
ALLOW_INSECURE_BASE_URL=false
ALLOW_PRIVATE_BASE_URL_FOR_DEV=false
CUSTOM_BASE_URL_TIMEOUT=10s
CUSTOM_BASE_URL_MAX_RESPONSE_BYTES=2097152

# 会话与限流
DATA_RETENTION_DAYS=30
ANALYSIS_RATE_PER_MIN=6
ANALYSIS_RATE_PER_HOUR=30
CHAT_RATE_PER_MIN=20
TELEGRAM_MAX_CONCURRENCY=32
LLM_MAX_CONCURRENCY=16
MARKET_MAX_CONCURRENCY=8
MAX_PROMPT_TOKENS=6000
MAX_OUTPUT_TOKENS=4000
GLOBAL_DAILY_LLM_TOKENS=2000000

# MVP 必须保持 false
TRADING_ENABLED=false
